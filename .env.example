# 本文件是环境变量模板，复制为 .env 后填入真实密钥
# Windows 复制命令：copy .env.example .env

# DeepSeek Pro 槽：OpenAI 兼容 Chat Completions（联调可填智谱/GLM）
DEEPSEEK_PRO_API_KEY=sk-your-glm-or-pro-key-here
# GLM Coding 端点示例（与 mingli_agent 一致）
DEEPSEEK_PRO_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
# 上游真实模型名
UPSTREAM_MODEL_PRO=glm-4.6

# DeepSeek Flash 槽：Anthropic Messages（联调可填 MiniMax）
DEEPSEEK_FLASH_API_KEY=sk-your-minimax-key-here
# MiniMax 国内 Anthropic 兼容地址
DEEPSEEK_FLASH_BASE_URL=https://api.minimaxi.com/anthropic
# MiniMax 模型名（以控制台为准）
UPSTREAM_MODEL_FLASH=MiniMax-M3

# Pro 模型每分钟最多请求次数，超限返回 429
RATE_LIMIT_PRO=60
# Flash 模型每分钟最多请求次数，与 Pro 独立计数
RATE_LIMIT_FLASH=120

# 网关监听端口
PORT=8000
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Pro 槽协议：openai_responses（作业双协议·Responses）| openai_chat_completions
PRO_PROTOCOL=openai_responses
# 智谱 Coding Plan Responses 端点（官方 quick-start；勿用 /api/paas/v4 拼 /responses，会 404）
RESPONSES_BASE_URL=https://open.bigmodel.cn/api/v1
# RESPONSES_API_KEY 缺省回落 DEEPSEEK_PRO_API_KEY
