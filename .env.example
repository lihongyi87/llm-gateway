# 本文件是环境变量模板，复制为 .env 后填入真实密钥
# Windows 复制命令：copy .env.example .env

# DeepSeek v4 Pro 的 API Key（走 OpenAI Responses API）
DEEPSEEK_PRO_API_KEY=sk-your-deepseek-pro-key-here
# DeepSeek Pro 的上游地址
DEEPSEEK_PRO_BASE_URL=https://api.deepseek.com

# DeepSeek v4 Flash 的 API Key（走 Anthropic Messages API）
DEEPSEEK_FLASH_API_KEY=sk-your-deepseek-flash-key-here
# DeepSeek Flash 的 Anthropic 兼容地址（以官方文档为准）
DEEPSEEK_FLASH_BASE_URL=https://api.deepseek.com/anthropic

# Pro 模型每分钟最多请求次数，超限返回 429
RATE_LIMIT_PRO=60
# Flash 模型每分钟最多请求次数，与 Pro 独立计数
RATE_LIMIT_FLASH=120

# 网关监听端口
PORT=8000
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
